# Copy to .env.local (gitignored). Every variable is optional; each surface
# that needs one degrades to a visible "not open yet" state when it is unset.

# Canonical origin for sitemap, llms.txt, canonicals.
SITE_URL=https://www.regenhealth.app

# Hero stat row reads live counts from the app's Firestore (REST, no key).
FIREBASE_PROJECT_ID=regen-health-app
FIREBASE_DATABASE_ID=regen

# Web sign-in (Google + Apple), the app's own Firebase project. Register a
# Web app in the Firebase console (Project settings > Your apps > Add app >
# Web), copy its config here, add regenhealth.app to Authentication >
# Settings > Authorized domains, and enable Apple as a provider with the
# Services ID and return URL from Apple Developer.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=regen-health-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=regen-health-app
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_ID=regen

# Newsletter signups (/api/subscribe) and vendor submissions
# (/api/vendors/submit) forward JSON to these webhooks (Zapier, Make, a
# Cloud Function) which deliver to email. Unset = the form says it is closed.
NEWSLETTER_WEBHOOK_URL=
VENDOR_SUBMISSIONS_WEBHOOK_URL=

# The library generator (scripts/build-library-guides.mjs) and the vendor
# submission pre-check call Claude. Not needed to run the site.
ANTHROPIC_API_KEY=
